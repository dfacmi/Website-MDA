rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'teguhade1926@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasValidImagePrefix(val) {
      return val.size() >= 32
        && val.size() <= 750000
        && (
          val[0:23] == 'data:image/jpeg;base64,'
          || val[0:22] == 'data:image/png;base64,'
          || val[0:23] == 'data:image/webp;base64,'
        );
    }

    // Validation Blueprint for SitePhoto
    function isValidSitePhoto(data, slotId) {
      return data.keys().hasAll(['slotId', 'dataUrl', 'isPublic', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['slotId', 'dataUrl', 'isPublic', 'updatedBy', 'updatedAt'])
        && data.slotId is string
        && data.slotId.size() >= 1
        && data.slotId.size() <= 64
        && data.slotId == slotId
        && data.dataUrl is string
        && hasValidImagePrefix(data.dataUrl)
        && data.isPublic is bool
        && data.isPublic == true
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation Blueprint for PpdbRegistration (create)
    function isValidPpdbRegistration(data, registrationId) {
      return data.keys().hasAll([
          'registrationId',
          'studentName',
          'schoolOrigin',
          'parentName',
          'whatsapp',
          'programInterest',
          'notes',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'registrationId',
          'studentName',
          'schoolOrigin',
          'parentName',
          'whatsapp',
          'programInterest',
          'notes',
          'status',
          'createdAt'
        ])
        && data.registrationId is string
        && data.registrationId.size() >= 4
        && data.registrationId.size() <= 64
        && data.registrationId == registrationId
        && data.studentName is string
        && data.studentName.size() >= 2
        && data.studentName.size() <= 120
        && data.schoolOrigin is string
        && data.schoolOrigin.size() <= 150
        && data.parentName is string
        && data.parentName.size() >= 2
        && data.parentName.size() <= 120
        && data.whatsapp is string
        && data.whatsapp.size() >= 8
        && data.whatsapp.size() <= 30
        && data.programInterest is string
        && data.programInterest.size() >= 1
        && data.programInterest.size() <= 80
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status is string
        && data.status == 'baru'
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Validation Blueprint for PpdbRegistration (admin update)
    function isValidPpdbRegistrationUpdate(data, registrationId) {
      return data.keys().hasAll([
          'registrationId',
          'studentName',
          'schoolOrigin',
          'parentName',
          'whatsapp',
          'programInterest',
          'notes',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'registrationId',
          'studentName',
          'schoolOrigin',
          'parentName',
          'whatsapp',
          'programInterest',
          'notes',
          'status',
          'createdAt'
        ])
        && data.registrationId is string
        && data.registrationId == registrationId
        && data.status is string
        && data.status in ['baru', 'diproses', 'selesai']
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp;
    }

    // Validation Blueprint for ContactMessage
    function isValidContactMessage(data, messageId) {
      return data.keys().hasAll(['messageId', 'name', 'email', 'message', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'name', 'email', 'message', 'createdAt'])
        && data.messageId is string
        && data.messageId.size() >= 4
        && data.messageId.size() <= 64
        && data.messageId == messageId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 254
        && data.message is string
        && data.message.size() >= 5
        && data.message.size() <= 2000
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Publicly viewable website photos managed exclusively by verified MDA administrators
    match /site_photos/{slotId} {
      allow get: if isValidId(slotId) && (resource == null || existing().isPublic == true);
      allow list: if resource.data.isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(slotId)
        && isValidSitePhoto(incoming(), slotId)
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(slotId)
        && isValidSitePhoto(incoming(), slotId)
        && incoming().slotId == existing().slotId
        && incoming().diff(existing()).affectedKeys().hasOnly(['dataUrl', 'isPublic', 'updatedBy', 'updatedAt'])
        && isAdmin();

      allow delete: if isVerifiedUser()
        && isValidId(slotId)
        && isAdmin();
    }

    // Public write-once PPDB online registrations; PII readable/manageable strictly by verified admins
    match /ppdb_registrations/{registrationId} {
      allow get: if isVerifiedUser() && isValidId(registrationId) && isAdmin();
      allow list: if isBootstrappedAdmin() && resource.data.registrationId is string;

      allow create: if isValidId(registrationId)
        && isValidPpdbRegistration(incoming(), registrationId);

      allow update: if isVerifiedUser()
        && isValidId(registrationId)
        && isValidPpdbRegistrationUpdate(incoming(), registrationId)
        && incoming().registrationId == existing().registrationId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes'])
        && isAdmin();

      allow delete: if isVerifiedUser() && isValidId(registrationId) && isAdmin();
    }

    // Public write-once Contact inquiries; PII readable strictly by verified admins
    match /contact_messages/{messageId} {
      allow get: if isVerifiedUser() && isValidId(messageId) && isAdmin();
      allow list: if isBootstrappedAdmin() && resource.data.messageId is string;

      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming(), messageId);

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(messageId) && isAdmin();
    }

    // Admin registry (closed to all client mutations to prevent self-promotion)
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }
  }
}
